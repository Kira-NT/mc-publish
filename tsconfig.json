{
    "include": ["./src/**/*", "./scripts/**/*"],
    "exclude": ["node_modules", "./test/**/*"],
    "isolatedModules": true,
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "node10",
        "esModuleInterop": true,

        "rootDir": "./",
        "outDir": "./dist",

        "paths": {
            "@/*": ["./src/*"],
        }
    },
}
